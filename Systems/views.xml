<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <chase-distance-m type="double" archive="y">-15</chase-distance-m>

  <view n="100">
    <name type="string">Tail Camera View</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01</ground-level-nearplane-m>

      <!-- Right -->
      <x-offset-m archive="y">0.000</x-offset-m>

      <!-- Up -->
      <y-offset-m archive="y">1.066</y-offset-m>

      <!-- Back -->
      <z-offset-m archive="y">2.700</z-offset-m>

      <default-field-of-view-deg type="double">30</default-field-of-view-deg>
      <pitch-offset-deg type="double">-5</pitch-offset-deg>
    </config>
  </view>

  <view n="101">
    <name type="string">CoPilote</name>
    <internal archive="y">true</internal>
    <type>lookfrom</type>
    <config>
      <dynamic-view type="bool">true</dynamic-view>
      <from-model type="bool">true</from-model>
      <ground-level-nearplane-m type="double">0.5</ground-level-nearplane-m>

      <!-- Right -->
      <x-offset-m archive="y">0.290</x-offset-m>

      <!-- Up -->
      <y-offset-m archive="y">0.285</y-offset-m>

      <!-- Back -->
      <z-offset-m archive="y">-1.391</z-offset-m>

      <pitch-offset-deg type="double">-1</pitch-offset-deg>
      <default-field-of-view-deg type="double">100</default-field-of-view-deg>
    </config>
  </view>

  <view n="0">
    <name type="string">Cockpit View</name>
    <internal archive="y">true</internal>
    <config>

      <!-- Right -->
      <x-offset-m archive="y">-0.290</x-offset-m>

      <!-- Up -->
      <y-offset-m archive="y">0.285</y-offset-m>

      <!-- Back -->
      <z-offset-m archive="y">-1.391</z-offset-m>

      <pitch-offset-deg type="double">-1</pitch-offset-deg>
      <default-field-of-view-deg type="double">100</default-field-of-view-deg>
    </config>
  </view>

  <view n="1">
    <config>
      <target-z-offset-m archive="y" type="double">0</target-z-offset-m>
    </config>
  </view>

  <view n="2">
    <config>
      <target-z-offset-m archive="y" type="double">0</target-z-offset-m>
    </config>
  </view>

  <view n="3">
    <config>
      <target-z-offset-m archive="y" type="double">0</target-z-offset-m>
    </config>
  </view>

  <view n="4">
    <config>
      <target-z-offset-m archive="y" type="double">0</target-z-offset-m>
    </config>
  </view>

  <view n="5">
    <config>
      <target-z-offset-m archive="y" type="double">0</target-z-offset-m>
    </config>
  </view>

  <view n="6">
    <config>
      <target-z-offset-m archive="y" type="double">0</target-z-offset-m>
    </config>
  </view>

</PropertyList>
