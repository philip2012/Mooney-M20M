<system name="powerplant-controls">
    <!-- init properties-->
    <property value="0">systems/powerplant-controls/engine/handles/throttle-norm</property>
    <property value="0">systems/powerplant-controls/engine/handles/mixture-norm</property>
    <property value="1">systems/powerplant-controls/engine/handles/prop-norm</property>

    <property value="0">systems/powerplant-controls/engine/switches/starter</property>
    <property value="0">systems/powerplant-controls/engine/switches/magnetos</property>

    <property value="0">systems/powerplant-controls/engine/states/starter-engaged</property>
    <property value="0">systems/powerplant-controls/engine/states/ignition-enabled</property>
    <property value="0">systems/powerplant-controls/engine/states/fuel-enabled</property>
    <property value="0">systems/powerplant-controls/engine/states/start-allowed</property>

    <property value="0">systems/powerplant-controls/electrical/switches/battery-master</property>
    <property value="0">systems/powerplant-controls/electrical/states/power-available</property>

    <property value="0">systems/powerplant-controls/electrical/switches/alternator</property>
    <property value="0">systems/powerplant-controls/electrical/states/generation-available</property>

    <channel name="generation-logic">
        <switch name="powerplant-controls/generation-available">
            <default value="0" />
            <test value="1" logic="AND">
                systems/powerplant-controls/electrical/switches/alternator == 1
                /engines/engine[0]/running == 1
            </test>
            <output>systems/powerplant-controls/electrical/states/generation-available</output>
        </switch>
    </channel>

    <channel name="electrical-logic">
        <switch name="powerplant-controls/power-available">
            <default value="0" />
            <test value="1" logic="OR">
                systems/powerplant-controls/electrical/switches/battery-master == 1
                systems/powerplant-controls/electrical/states/generation-available == 1
            </test>
            <output>systems/powerplant-controls/electrical/states/power-available</output>
        </switch>
    </channel>

    <channel name="ignition-logic">
        <switch name="powerplant-controls/ignition-enabled">
            <default value="0" />
            <test value="1">
                systems/powerplant-controls/engine/switches/magnetos > 0
            </test>
            <output>systems/powerplant-controls/engine/states/ignition-enabled</output>
        </switch>
    </channel>

    <channel name="fuel-logic">
        <switch name="powerplant-controls/fuel-enabled">
            <default value="0" />
            <test value="1">
                systems/powerplant-controls/engine/handles/mixture-norm > 0.1
            </test>
            <output>systems/powerplant-controls/engine/states/fuel-enabled</output>
        </switch>
    </channel>

    <channel name="starter-logic">
        <switch name="powerplant-controls/starter-engaged">
            <default value="0" />
            <test value="1">
                systems/powerplant-controls/engine/switches/starter == 1
            </test>
            <output>systems/powerplant-controls/engine/states/starter-engaged</output>
        </switch>
        <switch name="powerplant-controls/start-allowed">
            <default value="0" />
            <test value="1" logic="AND">
                systems/powerplant-controls/engine/states/starter-engaged == 1
                systems/powerplant-controls/engine/states/ignition-enabled == 1
                systems/powerplant-controls/engine/states/fuel-enabled == 1
                systems/powerplant-controls/electrical/states/power-available == 1
            </test>
            <output>systems/powerplant-controls/engine/states/start-allowed</output>
        </switch>
    </channel>

    <channel name="output-routing">
        <!-- <switch name="powerplant-controls/starter-to-engine">
            <default value="0" />
            <test value="1">
                systems/powerplant-controls/engine/states/start-allowed == 1
            </test>
            <output>/controls/engines/engine[0]/starter</output>
        </switch> -->
        <switch name="powerplant-controls/magnetos-to-engine">
            <default value="0" />
            <test value="1">
                systems/powerplant-controls/engine/switches/magnetos == 1
            </test>
            <test value="2">
                systems/powerplant-controls/engine/switches/magnetos == 2
            </test>
            <test value="3">
                systems/powerplant-controls/engine/switches/magnetos == 3
            </test>
            <output>/controls/engines/engine[0]/magnetos</output>
        </switch>

        <pure_gain name="powerplant-controls/mixture-to-engine">
            <input>systems/powerplant-controls/engine/handles/mixture-norm</input>
            <gain>1.0</gain>
            <output>/controls/engines/engine[0]/mixture</output>
        </pure_gain>

        <pure_gain name="powerplant-controls/throttle-to-engine">
            <input>systems/powerplant-controls/engine/handles/throttle-norm</input>
            <gain>1.0</gain>
            <output>/controls/engines/engine[0]/throttle</output>
        </pure_gain>

        <pure_gain name="powerplant-controls/prop-to-engine">
            <input>systems/powerplant-controls/engine/handles/prop-norm</input>
            <gain>1.0</gain>
            <output>/controls/engines/engine[0]/propeller-pitch</output>
        </pure_gain>
    </channel>
</system>