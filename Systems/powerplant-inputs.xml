<PropertyList>

    <!--
    FlightGear-facing engine controls are the pilot-input source.

    This bridge copies them into the aircraft-local JSBSim powerplant
    control properties. JSBSim systems remain independent of the
    FlightGear /controls tree.
    -->

    <filter>
        <name>powerplant-input-throttle</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/throttle</property>
        </input>
        <output>
            /fdm/jsbsim/systems/powerplant-controls/engine/handles/throttle-norm
        </output>
    </filter>

    <filter>
        <name>powerplant-input-mixture</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/mixture</property>
        </input>
        <output>
            /fdm/jsbsim/systems/powerplant-controls/engine/handles/mixture-norm
        </output>
    </filter>

    <filter>
        <name>powerplant-input-propeller</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/propeller-pitch</property>
        </input>
        <output>
            /fdm/jsbsim/systems/powerplant-controls/engine/handles/prop-norm
        </output>
    </filter>

    <filter>
        <name>powerplant-input-magnetos</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/magnetos</property>
        </input>
        <output>
            /fdm/jsbsim/systems/powerplant-controls/engine/switches/magnetos
        </output>
    </filter>

    <filter>
        <name>powerplant-input-starter</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/starter</property>
        </input>
        <output>
            /fdm/jsbsim/systems/powerplant-controls/engine/switches/starter
        </output>
    </filter>


    <filter>
        <name>powerplant-input-battery-master</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/master-bat</property>
        </input>
        <output>/fdm/jsbsim/systems/powerplant-controls/electrical/switches/battery-master</output>
    </filter>

    <filter>
        <name>powerplant-input-alternator</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <property>/controls/engines/engine[0]/master-alt</property>
        </input>
        <output>/fdm/jsbsim/systems/powerplant-controls/electrical/switches/alternator</output>
    </filter>

</PropertyList>
