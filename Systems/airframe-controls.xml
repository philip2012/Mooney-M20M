<system name="airframe-controls">
    <!-- flap selector:
         0 = UP
         1 = T/O (10 deg)
         2 = DOWN (33 deg)
    -->

    <property value="0">systems/airframe-controls/flaps/selector</property>
    <property value="0">systems/airframe-controls/flaps/selected-deg</property>

    <!-- flaps state properties-->
    <property value="0.0">systems/airframe-controls/flaps/target-norm</property>
    <property value="0.0">systems/airframe-controls/flaps/actual-norm</property>
    <property value="0">systems/airframe-controls/flaps/in-transit</property>
    <property value="0">systems/airframe-controls/flaps/actual-deg</property>

    <channel name="flap-detents">
        <switch name="airframe-controls/flap-target-norm">
            <default value="0.0" />
            <test value="0.303030303030303">
                systems/airframe-controls/flaps/selector == 1
            </test>
            <test value="1.0">
                systems/airframe-controls/flaps/selector == 2
            </test>
            <output>systems/airframe-controls/flaps/target-norm</output>
        </switch>

        <switch name="airframe-controls/flap-selected-deg">
            <default value="0" />
            <test value="10">
                systems/airframe-controls/flaps/selector == 1
            </test>
            <test value="33">
                systems/airframe-controls/flaps/selector == 2
            </test>
            <output>systems/airframe-controls/flaps/selected-deg</output>
        </switch>
    </channel>

    <channel name="flap-actuation">
        <kinematic name="airframe-controls/flap-travel">
            <input>systems/airframe-controls/flaps/target-norm</input>
            <noscale />
            <traverse>
                <setting>
                    <position>0.0</position>
                    <time>0.0</time>
                </setting>
                <setting>
                    <position>0.303030303030303</position>
                    <time>1.5</time>
                </setting>
                <setting>
                    <position>1.0</position>
                    <time>4.0</time>
                </setting>
            </traverse>
            <output>systems/airframe-controls/flaps/actual-norm</output>
        </kinematic>

        <pure_gain name="airframe-controls/flap-actual-to-fcs">
            <input>systems/airframe-controls/flaps/actual-norm</input>
            <gain>1.0</gain>
            <output>fcs/flap-cmd-norm</output>
        </pure_gain>

        <pure_gain name="airframe-controls/flap-actual-deg">
            <input>systems/airframe-controls/flaps/actual-norm</input>
            <gain>33.0</gain>
            <output>systems/airframe-controls/flaps/actual-deg</output>
        </pure_gain>
    </channel>

    <channel name="flap-state">
        <switch name="airframe-controls/flap-in-transit">
            <default value="1" />
            <test value="0" logic="AND">
                systems/airframe-controls/flaps/selector == 0
                systems/airframe-controls/flaps/actual-norm &lt; 0.01
            </test>
            <test value="0" logic="AND">
                systems/airframe-controls/flaps/selector == 1
                systems/airframe-controls/flaps/actual-norm > 0.29
                systems/airframe-controls/flaps/actual-norm &lt; 0.31
            </test>
            <test value="0" logic="AND">
                systems/airframe-controls/flaps/selector == 2
                systems/airframe-controls/flaps/actual-norm > 0.99
            </test>
            <output>systems/airframe-controls/flaps/in-transit</output>
        </switch>
    </channel>


    <!-- gear selector:
         0 = UP
         1 = DOWN
    -->
    <property value="1">systems/airframe-controls/gear/selector</property>
    <property value="1">systems/airframe-controls/gear/selected</property>

    <!-- gear state properties-->
    <property value="1.0">systems/airframe-controls/gear/target-norm</property>
    <property value="1.0">systems/airframe-controls/gear/actual-norm</property>
    <property value="0">systems/airframe-controls/gear/in-transit</property>
    <property value="0">systems/airframe-controls/gear/up-locked</property>
    <property value="1">systems/airframe-controls/gear/down-locked</property>
    <property value="1">systems/airframe-controls/gear/handle</property>
    <property value="1">systems/airframe-controls/gear/retract-allowed</property>

    <channel name="gear-selector">
        <switch name="airframe-controls/gear-retract-allowed">
            <default value="1" />
            <test value="0" logic="OR">
                gear/unit[0]/WOW == 1
                gear/unit[1]/WOW == 1
                gear/unit[2]/WOW == 1
            </test>
            <output>systems/airframe-controls/gear/retract-allowed</output>
        </switch>

        <switch name="airframe-controls/gear-selector-accepted">
            <default value="1" />

            <!-- allow UP only if handle is UP and all WOW are false -->
            <test value="0" logic="AND">
                systems/airframe-controls/gear/handle == 0
                systems/airframe-controls/gear/retract-allowed == 1
            </test>

            <!-- otherwise force selector DOWN -->
            <test value="1">
                systems/airframe-controls/gear/handle == 1
            </test>

            <output>systems/airframe-controls/gear/selector</output>
        </switch>

        <switch name="airframe-controls/gear-target">
            <default value="0.0" />
            <test value="1.0">
                systems/airframe-controls/gear/selector == 1
            </test>
            <output>systems/airframe-controls/gear/target-norm</output>
        </switch>

        <switch name="airframe-controls/gear-selected">
            <default value="0" />
            <test value="1">
                systems/airframe-controls/gear/selector == 1
            </test>
            <output>systems/airframe-controls/gear/selected</output>
        </switch>
    </channel>

    <channel name="gear-actuation">
        <pure_gain name="airframe-controls/gear-target-to-command">
            <input>systems/airframe-controls/gear/target-norm</input>
            <gain>1.0</gain>
            <output>gear/gear-cmd-norm</output>
        </pure_gain>

        <kinematic name="airframe-controls/gear-travel">
            <input>gear/gear-cmd-norm</input>
            <noscale />
            <traverse>
                <setting>
                    <position>0.0</position>
                    <time>0.0</time>
                </setting>
                <setting>
                    <position>1.0</position>
                    <time>6.0</time>
                </setting>
            </traverse>
            <output>gear/gear-pos-norm</output>
        </kinematic>

        <pure_gain name="airframe-controls/gear-pos-to-actual">
            <input>gear/gear-pos-norm</input>
            <gain>1.0</gain>
            <output>systems/airframe-controls/gear/actual-norm</output>
        </pure_gain>
    </channel>

    <channel name="gear-state">
        <switch name="airframe-controls/gear-in-transit">
            <default value="1" />

            <test value="0" logic="AND"> systems/airframe-controls/gear/selector == 0
                systems/airframe-controls/gear/actual-norm &lt; 0.01
            </test>

            <test value="0" logic="AND">
                systems/airframe-controls/gear/selector == 1
                systems/airframe-controls/gear/actual-norm > 0.99
            </test>

            <output>systems/airframe-controls/gear/in-transit</output>
        </switch>

        <switch name="airframe-controls/gear-up-locked">
            <default value="0" />
            <test value="1" logic="AND"> systems/airframe-controls/gear/selector == 0
                systems/airframe-controls/gear/actual-norm &lt; 0.01
            </test>
            <output>systems/airframe-controls/gear/up-locked</output>
        </switch>

        <switch name="airframe-controls/gear-down-locked">
            <default value="0" />
            <test value="1" logic="AND">
                systems/airframe-controls/gear/selector == 1
                systems/airframe-controls/gear/actual-norm > 0.99
            </test>
            <output>systems/airframe-controls/gear/down-locked</output>
        </switch>
    </channel>
</system>
