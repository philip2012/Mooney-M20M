<?xml version="1.0" encoding="UTF-8"?>

<!--
Temporary AF1B density-controller Stage-2 prototype.

THIS IS NOT A PERMANENT AIRCRAFT SYSTEM.

Purpose:
- evaluate the Lycoming Figure-17 MAP target surrogate
- evaluate temporary FGPiston VE compensation
- evaluate static feed-forward throttle limiting
- verify pilot-throttle minimum routing

No feedback integrator, rate limiting, activation blending,
or reduced-power VE scheduling is implemented here.
-->

<system name="af1b-density-controller-stage1">

    <property value="0">
        systems/af1b-density-controller/enabled
    </property>

    <!--
    VE activation is deliberately separate from throttle-controller
    activation so diagnostic tests can precondition the FGPiston
    compensation without simultaneously moving engine throttle.

    Production regime gating will be designed later.
    -->
    <property value="0">
        systems/af1b-density-controller/ve-enabled
    </property>

    <property value="1">
        systems/af1b-density-controller/constant-one
    </property>

    <!-- Fixed-point seed. Updated every FCS frame. -->
    <property value="35.0">
        systems/af1b-density-controller/target-map-inhg
    </property>

    <channel name="af1b-static-controller">

        <!-- Ambient pressure: psf -> inHg -->
        <pure_gain name="systems/af1b-density-controller/ambient-pressure-inhg">
            <input>atmosphere/P-psf</input>
            <gain>0.01413903097960689</gain>
        </pure_gain>

        <!--
        Figure-17 temperature surrogate:

          Tref,R =
              Tamb,R *
              (MAPtarget / Pamb)^(2/7)
              + 12.23

        target-map-inhg still contains the previous frame's result
        when this component executes, creating a fixed-point iteration.
        -->
        <fcs_function name="systems/af1b-density-controller/figure17-reference-temperature-r">
            <function>
                <sum>
                    <product>
                        <property>atmosphere/T-R</property>
                        <pow>
                            <quotient>
                                <property>systems/af1b-density-controller/target-map-inhg</property>
                                <property>systems/af1b-density-controller/ambient-pressure-inhg</property>
                            </quotient>
                            <value>0.2857142857142857</value>
                        </pow>
                    </product>

                    <value>12.23</value>
                </sum>
            </function>
        </fcs_function>

        <!--
        Lycoming SI 1187J Figure-17 normal-line surrogate:

          MAP = 32.15 + 0.030 * Tref,F
        -->
        <fcs_function name="systems/af1b-density-controller/target-map-inhg">
            <function>
                <sum>
                    <value>32.15</value>

                    <product>
                        <value>0.030</value>

                        <difference>
                            <property>systems/af1b-density-controller/figure17-reference-temperature-r</property>
                            <value>459.67</value>
                        </difference>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>30.0</min>
                <max>38.0</max>
            </clipto>
        </fcs_function>

        <!--
        Temporary FGPiston compensation coordinates:

          x = (Tamb,R - 500) / 100
          m = Pamb / MAPtarget
        -->
        <fcs_function name="systems/af1b-density-controller/ve-x">
            <function>
                <quotient>
                    <difference>
                        <property>atmosphere/T-R</property>
                        <value>500.0</value>
                    </difference>

                    <value>100.0</value>
                </quotient>
            </function>
        </fcs_function>

        <fcs_function name="systems/af1b-density-controller/ve-m">
            <function>
                <quotient>
                    <property>systems/af1b-density-controller/ambient-pressure-inhg</property>
                    <property>systems/af1b-density-controller/target-map-inhg</property>
                </quotient>
            </function>
        </fcs_function>

        <!--
        Temporary empirical FGPiston compensation surface:

          VE =
              0.56412103
            + 0.37457390*m
            - 0.05280825*m^2
            + 0.08601217*x
            + 0.01277322*x*m
            + 0.00986585*x^2

        This is NOT asserted to be physical Lycoming VE.
        -->
        <fcs_function name="systems/af1b-density-controller/ve-calibrated">
            <function>
                <sum>
                    <value>0.56412103</value>

                    <product>
                        <value>0.37457390</value>
                        <property>systems/af1b-density-controller/ve-m</property>
                    </product>

                    <product>
                        <value>-0.05280825</value>

                        <pow>
                            <property>systems/af1b-density-controller/ve-m</property>
                            <value>2.0</value>
                        </pow>
                    </product>

                    <product>
                        <value>0.08601217</value>
                        <property>systems/af1b-density-controller/ve-x</property>
                    </product>

                    <product>
                        <value>0.01277322</value>
                        <property>systems/af1b-density-controller/ve-x</property>
                        <property>systems/af1b-density-controller/ve-m</property>
                    </product>

                    <product>
                        <value>0.00986585</value>

                        <pow>
                            <property>systems/af1b-density-controller/ve-x</property>
                            <value>2.0</value>
                        </pow>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>0.55</min>
                <max>0.92</max>
            </clipto>
        </fcs_function>

        <!--
        Disabled:
            preserve permanent engine VE = 0.90

        Enabled:
            apply temporary full-power compensation.
        -->
        <switch name="systems/af1b-density-controller/ve-command">
            <default value="0.90"/>

            <test value="systems/af1b-density-controller/ve-calibrated">
                systems/af1b-density-controller/ve-enabled == 1
            </test>

            <output>propulsion/engine[0]/volumetric-efficiency</output>
        </switch>

        <!--
        Static feed-forward estimate:

          cap = 0.43 + 0.19 * (MAPtarget / Pamb)
        -->
        <fcs_function name="systems/af1b-density-controller/feedforward-cap-norm">
            <function>
                <sum>
                    <value>0.43</value>

                    <product>
                        <value>0.19</value>

                        <quotient>
                            <property>systems/af1b-density-controller/target-map-inhg</property>
                            <property>systems/af1b-density-controller/ambient-pressure-inhg</property>
                        </quotient>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>0.25</min>
                <max>1.0</max>
            </clipto>
        </fcs_function>

        <!--
        Feedback timing/reset control.

        Disabled:
            trigger = -1
            timer and integral reset to zero.

        Enabled:
            trigger = 0
            timer/integral may run.
        -->
        <switch name="systems/af1b-density-controller/feedback-reset-trigger">
            <default value="-1"/>

            <test value="0">
                systems/af1b-density-controller/enabled == 1
            </test>
        </switch>

        <!--
        Reproduce the diagnostic 1.5-second bumpless feedback delay.

        The feed-forward cap remains active during this interval.
        -->
        <integrator name="systems/af1b-density-controller/feedback-delay-sec">
            <input>systems/af1b-density-controller/constant-one</input>
            <c1 type="rect">1.0</c1>

            <trigger>
                systems/af1b-density-controller/feedback-reset-trigger
            </trigger>

            <clipto>
                <min>0.0</min>
                <max>1.5</max>
            </clipto>
        </integrator>

        <switch name="systems/af1b-density-controller/feedback-ready">
            <default value="0"/>

            <test value="1" logic="AND">
                systems/af1b-density-controller/enabled == 1
                systems/af1b-density-controller/feedback-delay-sec > 1.49
            </test>
        </switch>

        <!-- MAP error is positive when more throttle is required. -->
        <fcs_function name="systems/af1b-density-controller/map-error-inhg">
            <function>
                <difference>
                    <property>systems/af1b-density-controller/target-map-inhg</property>
                    <property>propulsion/engine[0]/map-inhg</property>
                </difference>
            </function>
        </fcs_function>

        <!-- Suppress feedback during the bumpless-delay interval. -->
        <switch name="systems/af1b-density-controller/feedback-error-gated">
            <default value="0"/>

            <test value="systems/af1b-density-controller/map-error-inhg">
                systems/af1b-density-controller/feedback-ready == 1
            </test>
        </switch>

        <!--
        Slow diagnostic trim:

            integral += 0.020 * MAP_error * dt

        This remains a model-calibration gain, not claimed AF1B
        density-controller hardware data.
        -->
        <integrator name="systems/af1b-density-controller/feedback-integral-norm">
            <input>
                systems/af1b-density-controller/feedback-error-gated
            </input>

            <c1 type="rect">0.020</c1>

            <trigger>
                systems/af1b-density-controller/feedback-reset-trigger
            </trigger>

            <clipto>
                <min>-0.25</min>
                <max>0.25</max>
            </clipto>
        </integrator>

        <fcs_function name="systems/af1b-density-controller/raw-controller-cap-norm">
            <function>
                <sum>
                    <property>
                        systems/af1b-density-controller/feedforward-cap-norm
                    </property>

                    <property>
                        systems/af1b-density-controller/feedback-integral-norm
                    </property>
                </sum>
            </function>

            <clipto>
                <min>0.25</min>
                <max>1.0</max>
            </clipto>
        </fcs_function>

        <!--
        Controller-cap actuator.

        0.25 -> 1.00 over 2.142857142857 s gives a constant
        rate of 0.35 normalized throttle units per second.
        -->
        <kinematic name="systems/af1b-density-controller/controller-cap-norm">
            <input>
                systems/af1b-density-controller/raw-controller-cap-norm
            </input>

            <noscale/>

            <traverse>
                <setting>
                    <position>0.25</position>
                    <time>0.0</time>
                </setting>

                <setting>
                    <position>1.0</position>
                    <time>2.142857142857143</time>
                </setting>
            </traverse>

            <clipto>
                <min>0.25</min>
                <max>1.0</max>
            </clipto>
        </kinematic>

        <!-- Controller is a CAP, never an independent throttle command. -->
        <fcs_function name="systems/af1b-density-controller/limited-throttle-norm">
            <function>
                <min>
                    <property>systems/powerplant-controls/engine/handles/throttle-norm</property>
                    <property>systems/af1b-density-controller/controller-cap-norm</property>
                </min>
            </function>
        </fcs_function>

        <!--
        Disabled: pilot throttle passes through unchanged.
        Enabled: engine sees min(pilot throttle, controller cap).
        -->
        <switch name="systems/af1b-density-controller/engine-throttle-command-norm">
            <default value="systems/powerplant-controls/engine/handles/throttle-norm"/>

            <test value="systems/af1b-density-controller/limited-throttle-norm">
                systems/af1b-density-controller/enabled == 1
            </test>

            <output>fcs/throttle-cmd-norm[0]</output>
        </switch>

    </channel>

</system>
