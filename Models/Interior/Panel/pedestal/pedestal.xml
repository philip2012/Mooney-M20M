<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>pedestal.ac</path>

  <animation>
    <object-name>pedestal</object-name>
    <object-name>throttle-knob</object-name>
    <object-name>rpm-knob</object-name>
    <object-name>mixture-knob</object-name>
    <object-name>flap-lever-up</object-name>
    <object-name>flap-lever</object-name>
    <object-name>flap-lever-down</object-name>
    <object-name>hotspot-up</object-name>
    <object-name>hotspot-down</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>throttle-knob</object-name>
    <property>controls/engines/engine[0]/throttle</property>
    <factor> 60 </factor>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0 </y-m>
      <z-m> 0 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>rpm-knob</object-name>
    <property>controls/engines/engine[0]/propeller-pitch</property>
    <factor> 60 </factor>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0 </y-m>
      <z-m> 0 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>mixture-knob</object-name>
    <property>controls/engines/engine[0]/mixture</property>
    <factor> 60 </factor>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0 </y-m>
      <z-m> 0 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>
