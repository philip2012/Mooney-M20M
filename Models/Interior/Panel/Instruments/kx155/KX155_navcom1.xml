    <action>
      <button>4</button>
      <repeatable>false</repeatable>
      <binding>
        <condition>
          <not>
            <property>devices/status/keyboard/shift</property>
          </not>
        </condition>
        <command>property-adjust</command>
        <property alias="../../../../params/nav-frq-standby"/>
        <step>-1</step>
        <min>108.0</min>
        <max>118.0</max>
        <wrap>true</wrap>
        <mask>integer</mask>
      </binding>
    </action>
  </animation>

  <animation>
    <type>pick</type>
