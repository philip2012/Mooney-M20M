<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>map.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>canvasCadre</object-name>
    <object-name>cache</object-name>
    <object-name>knobsMAP</object-name>
    <object-name>knobsND</object-name>
    <object-name>knobsZOOM</object-name>

    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>canvasCadre</object-name>
    <object-name>cache</object-name>
    <object-name>knobsMAP</object-name>
    <object-name>knobsND</object-name>
    <object-name>knobsZOOM</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>../../../../Effects/Glass/glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>canvasCadre</object-name>
    <object-name>knobsMAP</object-name>
    <object-name>knobsND</object-name>
    <object-name>knobsZOOM</object-name>
    <condition>
      <property>/controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>select</type>
    <object-name>cache</object-name>
    <condition>
      <not><property>/controls/electric/battery-switch</property></not>
    </condition>
  </animation>

  <!--ROUTE MANAGER -->
  <model>
    <path>nd/nd.xml</path>
    <condition>
      <and>
        <property>controls/electric/battery-switch</property>
        <equals>
          <property>sim/model/show-mapnd</property>
          <value>1</value>
        </equals>
      </and>
    </condition>
    <offsets>
      <x-m> -0.00415 </x-m>
      <y-m> -0.00819 </y-m>
      <z-m> -0.00742 </z-m>
    </offsets>
    <overlay>
      <animation n="100">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 0.976 </x-offset>
        <y-offset> 0.830 </y-offset>
        <z-offset> 0.543 </z-offset>
      </animation>
    </overlay>
  </model>

  <animation>
    <type>pick</type>
    <object-name>knobsZOOM</object-name>
    <action>
      <button>3</button> <!--  scroll down -->
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>sim/model/click</property>
      </binding>
      <binding>
        <condition>
          <and>
            <property>controls/electric/battery-switch</property>
            <equals>
              <property>sim/model/show-mapnd</property>
              <value>1</value>
            </equals>
          </and>
        </condition>
        <command>property-adjust</command>
        <property>instrumentation/efis/inputs/range-nm</property>
        <step>-1</step>
        <min>0</min>
        <max>360</max>
        <wrap>true</wrap>
      </binding>
    </action>
    <action>
      <button>4</button>      <!--  scroll up -->
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>sim/model/click</property>
      </binding>
      <binding>
        <condition>
          <and>
            <property>controls/electric/battery-switch</property>
            <equals>
              <property>sim/model/show-mapnd</property>
              <value>1</value>
            </equals>
          </and>
        </condition>
        <command>property-adjust</command>
        <property>instrumentation/efis/inputs/range-nm</property>
        <step>1</step>
        <min>0</min>
        <max>360</max>
        <wrap>true</wrap>
      </binding>
    </action>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>knobsMAP</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-assign</command>
        <property>sim/model/show-mapnd</property>
        <value>0</value>
      </binding>
    </action>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>knobsND</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-assign</command>
        <property>sim/model/show-mapnd</property>
        <value>1</value>
      </binding>
    </action>
  </animation>

</PropertyList>
