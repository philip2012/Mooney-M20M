<PropertyList>
    <name type="string">approach</name>
    <readable-name type="string">Final Approach</readable-name>
    <description type="string">Configured for a stable final approach</description>

    <overlay>

        <controls>
            <engines>
                <engine n="0">
                    <throttle type="double">0.425</throttle>
                    <mixture type="double">1.0</mixture>
                    <propeller-pitch type="double">1.0</propeller-pitch>
                    <starter type="bool">false</starter>
                    <magnetos type="int">3</magnetos>
                    <master-bat type="bool">true</master-bat>
                    <master-alt type="bool">true</master-alt>
                </engine>
            </engines>
        </controls>
        <fdm>
            <jsbsim>
                <systems>

                    <airframe-controls>
                        <flaps>
                            <selector type="int">2</selector>
                        </flaps>
                        <gear>
                            <handle type="int">1</handle>
                        </gear>
                    </airframe-controls>
                </systems>
            </jsbsim>
        </fdm>
    </overlay>
</PropertyList>
