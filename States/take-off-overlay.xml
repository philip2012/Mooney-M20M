<PropertyList>
    <name type="string">take-off</name>
    <readable-name type="string">Take-off</readable-name>
    <description type="string">Configured for take-off with engine started automatically.</description>

    <overlay>

        <controls>
            <engines>
                <engine n="0">
                    <throttle type="double">0.0</throttle>
                    <mixture type="double">1.0</mixture>
                    <propeller-pitch type="double">1.0</propeller-pitch>
                    <starter type="bool">false</starter>
                    <magnetos type="int">3</magnetos>
                </engine>
            </engines>
        </controls>
        <fdm>
            <jsbsim>
                <systems>
                    <powerplant-controls>

                        <electrical>
                            <switches>
                                <battery-master type="int">1</battery-master>
                                <alternator type="int">1</alternator>
                            </switches>
                        </electrical>
                    </powerplant-controls>

                    <airframe-controls>
                        <flaps>
                            <selector type="int">1</selector>
                        </flaps>
                    </airframe-controls>
                </systems>
            </jsbsim>
        </fdm>
    </overlay>
</PropertyList>
