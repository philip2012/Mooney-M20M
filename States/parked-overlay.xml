<PropertyList>
    <name type="string">parked</name>
    <readable-name type="string">Parked</readable-name>
    <description type="string">Parked, cold and dark.</description>

    <overlay>

        <controls>
            <engines>
                <engine n="0">
                    <throttle type="double">0.0</throttle>
                    <mixture type="double">0.0</mixture>
                    <propeller-pitch type="double">1.0</propeller-pitch>
                    <starter type="bool">false</starter>
                    <magnetos type="int">0</magnetos>
                </engine>
            </engines>
            <lighting>
                <nav-lights type="bool">false</nav-lights>
                <beacon type="bool">false</beacon>
                <strobe type="bool">false</strobe>
                <landing-lights type="bool">false</landing-lights>
                <taxi-light type="bool">false</taxi-light>
            </lighting>
        </controls>
        <fdm>
            <jsbsim>
                <systems>
                    <powerplant-controls>

                        <electrical>
                            <switches>
                                <battery-master type="int">0</battery-master>
                                <alternator type="int">0</alternator>
                            </switches>
                        </electrical>
                    </powerplant-controls>
                </systems>
            </jsbsim>
        </fdm>
    </overlay>
</PropertyList>
