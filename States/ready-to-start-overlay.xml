<PropertyList>
    <name type="string">ready-to-start</name>
    <readable-name type="string">Ready to start</readable-name>
    <description type="string">Engine off, configured for immediate startup.</description>

    <overlay>
        <fdm>
            <jsbsim>
                <systems>
                    <powerplant-controls>
                        <engine>
                            <handles>
                                <throttle-norm type="double">0.12</throttle-norm>
                                <mixture-norm type="double">1.0</mixture-norm>
                                <prop-norm type="double">1.0</prop-norm>
                            </handles>

                            <switches>
                                <starter type="int">0</starter>
                                <magnetos type="int">3</magnetos>
                            </switches>
                        </engine>

                        <electrical>
                            <switches>
                                <battery-master type="int">1</battery-master>
                                <alternator type="int">0</alternator>
                            </switches>
                        </electrical>
                    </powerplant-controls>
                </systems>
            </jsbsim>
        </fdm>
    </overlay>
</PropertyList>