<PropertyList>
    <name type="string">ready-to-start</name>
    <readable-name type="string">Ready to start</readable-name>
    <description type="string">Engine off, configured for immediate startup.</description>

    <overlay>

        <controls>
            <engines>
                <engine n="0">
                    <throttle type="double">0.12</throttle>
                    <mixture type="double">1.0</mixture>
                    <propeller-pitch type="double">1.0</propeller-pitch>
                    <starter type="bool">false</starter>
                    <magnetos type="int">3</magnetos>
                </engine>
            </engines>
        </controls>
        <fdm>
            <jsbsim>
                <systems>
                    <powerplant-controls>

                        <electrical>
                            <switches>
                                <battery-master type="int">1</battery-master>
                                <alternator type="int">0</alternator>
                            </switches>
                        </electrical>
                    </powerplant-controls>
                </systems>
            </jsbsim>
        </fdm>
    </overlay>
</PropertyList>
