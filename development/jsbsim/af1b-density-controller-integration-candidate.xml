<?xml version="1.0" encoding="UTF-8"?>

<!--
AF1B density-controller integration candidate.

TOOLS-ONLY. NOT YET A PERMANENT AIRCRAFT SYSTEM.

Qualified candidate functions:
- Lycoming Figure-17 density-controller MAP demand surrogate
- pressure-scaled post-critical MAP capability candidate
- FGPiston VE compensation and boost-regime scheduling
- feed-forward throttle-cap estimation
- delayed integral MAP feedback
- upper directional anti-windup
- throttle-cap slew limiting
- pilot-throttle authority preservation

The non-ISA MAP capability scaling and empirical VE compensation
are model-calibration candidates. They are not asserted to be
literal Lycoming hardware equations.
-->

<system name="af1b-density-controller-integration-candidate">

    <property value="1">
        systems/af1b-density-controller/enabled
    </property>

    <!--
    VE activation is deliberately separate from throttle-controller
    activation so diagnostic tests can precondition the FGPiston
    compensation without simultaneously moving engine throttle.

    Production regime gating will be designed later.
    -->
    <property value="1">
        systems/af1b-density-controller/ve-enabled
    </property>


    <!--
    Stage-5C maximum-MAP capability layer.

    Diagnostic only.

    OFF:
        preserve qualified Stage-4B controller behavior.

    ON:
        limit the controller MAP target to the temporary
        Lycoming Figure-3-34 ISA capability schedule.
    -->
    <property value="1">
        systems/af1b-density-controller/capability-enabled
    </property>


    <property value="1">
        systems/af1b-density-controller/constant-one
    </property>

    <!--
    Explicit bridge to the permanent powerplant-control routing
    layer. A value of 1.0 means no controller throttle restriction.
    -->
    <property value="1.0">
        systems/af1b-density-controller/throttle-limit-norm
    </property>

    <!-- Fixed-point seed. Updated every FCS frame. -->
    <property value="35.0">
        systems/af1b-density-controller/target-map-inhg
    </property>

    <channel name="af1b-density-controller">

        <!--
        Runtime operational gate.

        The density controller may be configured on globally, but it
        must not assert throttle authority or empirical VE compensation
        while the engine is stopped or cranking.

        propulsion/engine[0]/set-running is already the aircraft's
        JSBSim engine-running state.
        -->
        <!--
        Common engine-running gate.

        Throttle control and VE compensation remain separately
        switchable, but neither may act while the engine is stopped
        or cranking.
        -->
        <switch name="systems/af1b-density-controller/engine-running-active">
            <default value="0"/>

            <test value="1">
                propulsion/engine[0]/set-running == 1
            </test>
        </switch>

        <switch name="systems/af1b-density-controller/operational-active">
            <default value="0"/>

            <test value="1" logic="AND">
                systems/af1b-density-controller/enabled == 1
                systems/af1b-density-controller/engine-running-active == 1
            </test>
        </switch>

        <switch name="systems/af1b-density-controller/ve-active">
            <default value="0"/>

            <test value="1" logic="AND">
                systems/af1b-density-controller/ve-enabled == 1
                systems/af1b-density-controller/engine-running-active == 1
            </test>
        </switch>


        <!-- Ambient pressure: psf -> inHg -->
        <pure_gain name="systems/af1b-density-controller/ambient-pressure-inhg">
            <input>atmosphere/P-psf</input>
            <gain>0.01413903097960689</gain>
        </pure_gain>

        <!--
        Figure-17 temperature surrogate:

          Tref,R =
              Tamb,R *
              (MAPtarget / Pamb)^(2/7)
              + 12.23

        target-map-inhg still contains the previous frame's result
        when this component executes, creating a fixed-point iteration.
        -->
        <fcs_function name="systems/af1b-density-controller/figure17-reference-temperature-r">
            <function>
                <sum>
                    <product>
                        <property>atmosphere/T-R</property>
                        <pow>
                            <quotient>
                                <property>systems/af1b-density-controller/target-map-inhg</property>
                                <property>systems/af1b-density-controller/ambient-pressure-inhg</property>
                            </quotient>
                            <value>0.2857142857142857</value>
                        </pow>
                    </product>

                    <value>12.23</value>
                </sum>
            </function>
        </fcs_function>

        <!--
        Lycoming SI 1187J Figure-17 normal-line surrogate:

          MAP = 32.15 + 0.030 * Tref,F
        -->
        <fcs_function name="systems/af1b-density-controller/target-map-inhg">
            <function>
                <sum>
                    <value>32.15</value>

                    <product>
                        <value>0.030</value>

                        <difference>
                            <property>systems/af1b-density-controller/figure17-reference-temperature-r</property>
                            <value>459.67</value>
                        </difference>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>30.0</min>
                <max>38.0</max>
            </clipto>
        </fcs_function>

        <!--
        Stage-5C internal pressure-scaled turbo-capability
        candidate.

        Figure 3-34 remains the ISA reference capability.

        Non-ISA candidate law:

            maximum MAP =
                Figure-3-34 ISA MAP
                * ambient pressure
                / ISA pressure at the same altitude

        The ISA-pressure lookup below is a reduced 1000-ft-node table generated directly
        from the JSBSim atmosphere used for qualification.

        TEMPORARY / TOOLS-ONLY.
        -->
        <fcs_function name="systems/af1b-density-controller/figure34-isa-maximum-map-inhg">
            <function>
                <table>
                    <independentVar lookup="row">
                        position/h-sl-ft
                    </independentVar>

                    <tableData>
                            0.0  38.0
                        19000.0  38.0
                        20000.0  36.5
                        21000.0  35.0
                        22000.0  33.5
                        23000.0  32.0
                        24000.0  30.5
                        25000.0  29.0
                    </tableData>
                </table>
            </function>
        </fcs_function>

        <fcs_function name="systems/af1b-density-controller/isa-pressure-inhg">
            <function>
                <table>
                    <independentVar lookup="row">
                        position/h-sl-ft
                    </independentVar>

                    <tableData>
                            
                            0.000000  29.92141325
                         1000.000000  28.85588548
                         2000.000000  27.82139078
                         3000.000000  26.81722869
                         4000.000000  25.84270995
                         5000.000000  24.89715636
                         6000.000000  23.97990071
                         7000.000000  23.09028666
                         8000.000000  22.22766863
                         9000.000000  21.39141172
                        10000.000000  20.58089158
                        11000.000000  19.79549431
                        12000.000000  19.03461640
                        13000.000000  18.29766455
                        14000.000000  17.58405565
                        15000.000000  16.89321662
                        16000.000000  16.22458432
                        17000.000000  15.57760548
                        18000.000000  14.95173657
                        19000.000000  14.34644370
                        20000.000000  13.76120252
                        21000.000000  13.19549815
                        22000.000000  12.64882504
                        23000.000000  12.12068689
                        24000.000000  11.61059655
                        25000.000000  11.11807593
                        26000.000000  10.64265587
                    </tableData>
                </table>
            </function>
        </fcs_function>

        <fcs_function name="systems/af1b-density-controller/pressure-scale">
            <function>
                <quotient>
                    <property>
                        systems/af1b-density-controller/ambient-pressure-inhg
                    </property>

                    <property>
                        systems/af1b-density-controller/isa-pressure-inhg
                    </property>
                </quotient>
            </function>
        </fcs_function>

        <fcs_function name="systems/af1b-density-controller/maximum-map-inhg">
            <function>
                <product>
                    <property>
                        systems/af1b-density-controller/figure34-isa-maximum-map-inhg
                    </property>

                    <property>
                        systems/af1b-density-controller/pressure-scale
                    </property>
                </product>
            </function>

            <clipto>
                <min>0.0</min>
                <max>38.0</max>
            </clipto>
        </fcs_function>

        <!--
        Disabled capability layer presents a harmless 38-inHg
        ceiling. Figure-17 target-map-inhg is already clipped
        to a maximum of 38 inHg.
        -->
        <switch name="systems/af1b-density-controller/effective-maximum-map-inhg">
            <default value="38.0"/>

            <test value="systems/af1b-density-controller/maximum-map-inhg">
                systems/af1b-density-controller/capability-enabled == 1
            </test>
        </switch>

        <!--
        Density-controller demand and turbo capability are
        deliberately separate concepts.

        Figure-17 density target:
            target-map-inhg

        Effective throttle-controller target:
            min(
                density target,
                available MAP capability
            )
        -->
        <fcs_function name="systems/af1b-density-controller/controller-target-map-inhg">
            <function>
                <min>
                    <property>
                        systems/af1b-density-controller/target-map-inhg
                    </property>

                    <property>
                        systems/af1b-density-controller/effective-maximum-map-inhg
                    </property>
                </min>
            </function>
        </fcs_function>


        <!--
        Temporary FGPiston compensation coordinates:

          x = (Tamb,R - 500) / 100
          m = Pamb / MAPtarget
        -->
        <fcs_function name="systems/af1b-density-controller/ve-x">
            <function>
                <quotient>
                    <difference>
                        <property>atmosphere/T-R</property>
                        <value>500.0</value>
                    </difference>

                    <value>100.0</value>
                </quotient>
            </function>
        </fcs_function>

        <fcs_function name="systems/af1b-density-controller/ve-m">
            <function>
                <quotient>
                    <property>systems/af1b-density-controller/ambient-pressure-inhg</property>
                    <property>systems/af1b-density-controller/target-map-inhg</property>
                </quotient>
            </function>
        </fcs_function>

        <!--
        Temporary empirical FGPiston compensation surface:

          VE =
              0.56412103
            + 0.37457390*m
            - 0.05280825*m^2
            + 0.08601217*x
            + 0.01277322*x*m
            + 0.00986585*x^2

        This is NOT asserted to be physical Lycoming VE.
        -->
        <fcs_function name="systems/af1b-density-controller/ve-calibrated">
            <function>
                <sum>
                    <value>0.56412103</value>

                    <product>
                        <value>0.37457390</value>
                        <property>systems/af1b-density-controller/ve-m</property>
                    </product>

                    <product>
                        <value>-0.05280825</value>

                        <pow>
                            <property>systems/af1b-density-controller/ve-m</property>
                            <value>2.0</value>
                        </pow>
                    </product>

                    <product>
                        <value>0.08601217</value>
                        <property>systems/af1b-density-controller/ve-x</property>
                    </product>

                    <product>
                        <value>0.01277322</value>
                        <property>systems/af1b-density-controller/ve-x</property>
                        <property>systems/af1b-density-controller/ve-m</property>
                    </product>

                    <product>
                        <value>0.00986585</value>

                        <pow>
                            <property>systems/af1b-density-controller/ve-x</property>
                            <value>2.0</value>
                        </pow>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>0.55</min>
                <max>0.92</max>
            </clipto>
        </fcs_function>

        <!--
        Stage-3A VE regime scheduling.

        The empirical VE surface above remains the full-power
        calibration target. Do not extrapolate that polynomial
        directly into reduced-power operation.

        Instead, blend from native VE = 0.90 toward the calibrated
        VE according to how much manifold boost is actually present.

            boost_fraction =
                (MAP - Pamb)
                /
                (MAPtarget - Pamb)

        boost_fraction is clipped to 0..1.

        Because FCS systems execute before propulsion, actual MAP
        here is from the previously completed propulsion frame.
        That one-frame (~8.33 ms at 120 Hz) scheduling latency is
        intentional for this diagnostic.
        -->

        <fcs_function name="systems/af1b-density-controller/ve-boost-span-inhg">
            <function>
                <difference>
                    <property>
                        systems/af1b-density-controller/target-map-inhg
                    </property>

                    <property>
                        systems/af1b-density-controller/ambient-pressure-inhg
                    </property>
                </difference>
            </function>

            <!--
            Avoid a pathological zero denominator. The present
            above-sea-level AF1B test envelope has a substantially
            positive boost span, so this floor should be inactive
            during normal Stage-3A qualification.
            -->
            <clipto>
                <min>0.10</min>
                <max>100.0</max>
            </clipto>
        </fcs_function>

        <fcs_function name="systems/af1b-density-controller/ve-boost-fraction">
            <function>
                <quotient>
                    <difference>
                        <property>
                            propulsion/engine[0]/map-inhg
                        </property>

                        <property>
                            systems/af1b-density-controller/ambient-pressure-inhg
                        </property>
                    </difference>

                    <property>
                        systems/af1b-density-controller/ve-boost-span-inhg
                    </property>
                </quotient>
            </function>

            <clipto>
                <min>0.0</min>
                <max>1.0</max>
            </clipto>
        </fcs_function>

        <!--
        Qualified endpoint-preserving post-critical VE schedule.

            b = boost_fraction

            gain =
                b
                + 0.62 * b * (1 - b)

            VE =
                0.90
                + gain * (VEcal - 0.90)

        Properties:
        - b = 0 -> native VE = 0.90 exactly
        - b = 1 -> VE = VEcal exactly
        - continuous and monotonic over b = 0..1
        - no binary authority selector
        - 0.62 is an empirical model-calibration coefficient,
          not a physical Lycoming volumetric-efficiency constant
        -->
        <fcs_function name="systems/af1b-density-controller/ve-scheduled">
            <function>
                <sum>
                    <value>0.90</value>

                    <product>
                        <sum>
                            <property>
                                systems/af1b-density-controller/ve-boost-fraction
                            </property>

                            <product>
                                <value>0.62</value>

                                <property>
                                    systems/af1b-density-controller/ve-boost-fraction
                                </property>

                                <difference>
                                    <value>1.0</value>

                                    <property>
                                        systems/af1b-density-controller/ve-boost-fraction
                                    </property>
                                </difference>
                            </product>
                        </sum>

                        <difference>
                            <property>
                                systems/af1b-density-controller/ve-calibrated
                            </property>

                            <value>0.90</value>
                        </difference>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>0.55</min>
                <max>0.92</max>
            </clipto>
        </fcs_function>

        <!--
        Disabled:
            preserve permanent engine VE = 0.90

        Enabled:
            apply temporary full-power compensation.
        -->
        <switch name="systems/af1b-density-controller/ve-command">
            <default value="0.90"/>

            <test value="systems/af1b-density-controller/ve-scheduled">
                systems/af1b-density-controller/ve-active == 1
            </test>

            <output>propulsion/engine[0]/volumetric-efficiency</output>
        </switch>

        <!--
        Static feed-forward estimate:

          cap = 0.43 + 0.19 * (MAPtarget / Pamb)
        -->
        <fcs_function name="systems/af1b-density-controller/feedforward-cap-norm">
            <function>
                <sum>
                    <value>0.43</value>

                    <product>
                        <value>0.19</value>

                        <quotient>
                            <property>systems/af1b-density-controller/controller-target-map-inhg</property>
                            <property>systems/af1b-density-controller/ambient-pressure-inhg</property>
                        </quotient>
                    </product>
                </sum>
            </function>

            <clipto>
                <min>0.25</min>
                <max>1.0</max>
            </clipto>
        </fcs_function>

        <!--
        Feedback timing/reset control.

        Disabled:
            trigger = -1
            timer and integral reset to zero.

        Enabled:
            trigger = 0
            timer/integral may run.
        -->
        <!--
        Density-controller feedback is authoritative only when the
        pilot is demanding at least the controller cap.

        If pilot throttle is below the cap, the density controller is
        not governing engine throttle and must not integrate the
        resulting low-MAP error as though it were an undersupply fault.

        controller-cap-norm is read from the previous completed FCS
        frame here. That one-frame state relationship is intentional.
        -->
        <fcs_function name="systems/af1b-density-controller/governing-margin-norm">
            <function>
                <difference>
                    <property>
                        systems/powerplant-controls/engine/handles/throttle-norm
                    </property>

                    <property>
                        systems/af1b-density-controller/controller-cap-norm
                    </property>
                </difference>
            </function>
        </fcs_function>

        <switch name="systems/af1b-density-controller/feedback-governing">
            <default value="0"/>

            <test value="1" logic="AND">
                systems/af1b-density-controller/operational-active == 1
                systems/af1b-density-controller/governing-margin-norm > -0.001
            </test>
        </switch>

        <switch name="systems/af1b-density-controller/feedback-reset-trigger">
            <default value="-1"/>

            <test value="0">
                systems/af1b-density-controller/operational-active == 1
            </test>
        </switch>

        <!--
        Delay timing is valid only while the density controller
        continuously owns throttle authority.

        -1 resets the delay integrator.
         0 allows it to count.
        -->
        <switch name="systems/af1b-density-controller/feedback-delay-reset-trigger">
            <default value="-1"/>

            <test value="0" logic="AND">
                systems/af1b-density-controller/operational-active == 1
                systems/af1b-density-controller/governing-margin-norm > -0.001
            </test>
        </switch>

        <!--
        Reproduce the diagnostic 1.5-second bumpless feedback delay.

        The feed-forward cap remains active during this interval.
        -->
        <integrator name="systems/af1b-density-controller/feedback-delay-sec">
            <input>systems/af1b-density-controller/constant-one</input>
            <c1 type="rect">1.0</c1>

            <trigger>
                systems/af1b-density-controller/feedback-delay-reset-trigger
            </trigger>

            <clipto>
                <min>0.0</min>
                <max>1.5</max>
            </clipto>
        </integrator>

        <switch name="systems/af1b-density-controller/feedback-ready">
            <default value="0"/>

            <test value="1" logic="AND">
                systems/af1b-density-controller/operational-active == 1
                systems/af1b-density-controller/governing-margin-norm > -0.001
                systems/af1b-density-controller/feedback-delay-sec > 1.499
            </test>
        </switch>

        <!-- MAP error is positive when more throttle is required. -->
        <fcs_function name="systems/af1b-density-controller/map-error-inhg">
            <function>
                <difference>
                    <property>systems/af1b-density-controller/controller-target-map-inhg</property>
                    <property>propulsion/engine[0]/map-inhg</property>
                </difference>
            </function>
        </fcs_function>

        <!-- Suppress feedback during the bumpless-delay interval. -->
        <switch name="systems/af1b-density-controller/feedback-error-gated">
            <default value="0"/>

            <test value="systems/af1b-density-controller/map-error-inhg"
                  logic="AND">
                systems/af1b-density-controller/feedback-ready == 1
                systems/af1b-density-controller/feedback-governing == 1
            </test>
        </switch>

        <!--
        Pre-integrator controller request.

        This deliberately uses the integral state from the previously
        completed controller component evaluation. It is NOT clipped,
        because directional anti-windup must know whether the controller
        is attempting to drive beyond its usable throttle-cap range.
        -->
        <fcs_function name="systems/af1b-density-controller/pre-integrator-controller-request-norm">
            <function>
                <sum>
                    <property>
                        systems/af1b-density-controller/feedforward-cap-norm
                    </property>

                    <property>
                        systems/af1b-density-controller/feedback-integral-norm
                    </property>
                </sum>
            </function>
        </fcs_function>

        <!--
        Upper directional anti-windup.

        Freeze only when the controller is already at/above its upper
        requested limit AND the MAP error is still asking for more
        throttle.

        If the MAP error reverses sign, integration is immediately
        allowed again so the controller can unwind away from saturation.
        -->
        <switch name="systems/af1b-density-controller/antiwindup-upper">
            <default value="0"/>

            <test value="1" logic="AND">
                systems/af1b-density-controller/operational-active == 1
                systems/af1b-density-controller/feedback-ready == 1
                systems/af1b-density-controller/feedback-governing == 1
                systems/af1b-density-controller/pre-integrator-controller-request-norm > 0.999999
                systems/af1b-density-controller/map-error-inhg > 0.0
            </test>
        </switch>

        <!--
        JSBSim integrator trigger semantics:

           negative -> reset integral
           zero     -> integrate normally
           positive -> hold/freeze integral

        Controller disable therefore retains the existing reset behavior,
        while upper outward saturation freezes without destroying the
        accumulated trim state.

        No lower directional anti-windup is required in the current
        controller envelope. Feed-forward remains sufficiently above the
        0.25 cap floor that the -0.25 integral limit cannot reach lower
        saturation in the intended above-sea-level operating regime.
        -->
        <switch name="systems/af1b-density-controller/feedback-integrator-trigger">
            <default value="-1"/>

            <test value="1">
                systems/af1b-density-controller/antiwindup-upper == 1
            </test>

            <test value="0">
                systems/af1b-density-controller/operational-active == 1
            </test>
        </switch>

        <!--
        Slow diagnostic trim:

            integral += 0.020 * MAP_error * dt

        This remains a model-calibration gain, not claimed AF1B
        density-controller hardware data.
        -->
        <integrator name="systems/af1b-density-controller/feedback-integral-norm">
            <input>
                systems/af1b-density-controller/feedback-error-gated
            </input>

            <c1 type="rect">0.020</c1>

            <trigger>
                systems/af1b-density-controller/feedback-integrator-trigger
            </trigger>

            <clipto>
                <min>-0.25</min>
                <max>0.25</max>
            </clipto>
        </integrator>

        <fcs_function name="systems/af1b-density-controller/raw-controller-cap-norm">
            <function>
                <sum>
                    <property>
                        systems/af1b-density-controller/feedforward-cap-norm
                    </property>

                    <property>
                        systems/af1b-density-controller/feedback-integral-norm
                    </property>
                </sum>
            </function>

            <clipto>
                <min>0.25</min>
                <max>1.0</max>
            </clipto>
        </fcs_function>

        <!--
        Controller-cap actuator.

        0.25 -> 1.00 over 2.142857142857 s gives a constant
        rate of 0.35 normalized throttle units per second.
        -->
        <!--
        Inactive controller request.

        Keep the internal slew-limited cap parked at 1.0 whenever
        operational authority is unavailable. This prevents a stale
        low cap from becoming effective immediately when the engine
        transitions to running.
        -->
        <switch name="systems/af1b-density-controller/active-controller-request-norm">
            <default value="1.0"/>

            <test value="systems/af1b-density-controller/raw-controller-cap-norm">
                systems/af1b-density-controller/engine-running-active == 1
            </test>
        </switch>

        <kinematic name="systems/af1b-density-controller/controller-cap-norm">
            <input>
                systems/af1b-density-controller/active-controller-request-norm
            </input>

            <noscale/>

            <traverse>
                <setting>
                    <position>0.25</position>
                    <time>0.0</time>
                </setting>

                <setting>
                    <position>1.0</position>
                    <time>2.142857142857143</time>
                </setting>
            </traverse>

            <clipto>
                <min>0.25</min>
                <max>1.0</max>
            </clipto>
        </kinematic>

        <!--
        Publish controller authority as a local throttle limit.

        The powerplant-controls routing layer remains the sole writer
        to fcs/throttle-cmd-norm[0].

        Disabled:
            limit = 1.0

        Enabled:
            limit = controller-cap-norm
        -->
        <switch name="systems/af1b-density-controller/throttle-limit-norm">
            <default value="1.0"/>

            <test value="systems/af1b-density-controller/controller-cap-norm">
                systems/af1b-density-controller/operational-active == 1
            </test>

            <output>
                systems/af1b-density-controller/throttle-limit-norm
            </output>
        </switch>

    </channel>

</system>
